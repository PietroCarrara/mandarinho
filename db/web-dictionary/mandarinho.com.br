server {
    server_name mandarinho.com.br www.mandarinho.com.br;

    location /static/ {
        root /var/www/mandarinho/;
        # 1. Core performance optimizations for file delivery
        sendfile on;
        sendfile_max_chunk 1m;
        tcp_nopush on;
    }

    location / {
        proxy_pass http://localhost:8888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mandarinho.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mandarinho.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = mandarinho.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name mandarinho.com.br www.mandarinho.com.br;
    listen 80;
    return 404; # managed by Certbot


}