[Unit]
Description=HTTP Server for mandarinho.com.br
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/mandarinho/db/web-dictionary
ExecStart=.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8888
Restart=always
RestartSec=5
KillMode=mixed
PrivateTmp=true

[Install]
WantedBy=multi-user.target
